# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","*"]

# Storage Path (where generated projects and zips will be stored)
STORAGE_DIR=./storage

# LLM budget. Groq free tier for gpt-oss-20b: 8,000 tokens/minute, 200,000 tokens/day.
GROQ_MAX_TOKENS=6144
# Prompts are trimmed (interface stubs instead of full files) to stay under this estimate.
# Lower it (e.g. 4500) if you see "413 Request too large".
GROQ_INPUT_TOKEN_BUDGET=6000
GROQ_REASONING_EFFORT=low
GROQ_MAX_RETRIES=8
# Used automatically when the main model's DAILY quota runs out (separate 200k/day). Empty = off.
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# Pipeline behaviour
# true = on Writer LLM failure ship a full template project marked degraded
ALLOW_TEMPLATE_FALLBACK=false
# LLM attempts per file when output is truncated / doesn't parse / has undefined names
WRITER_MAX_ATTEMPTS=3
# Reviewer -> Writer repair rounds when tests fail
MAX_REPAIR_ATTEMPTS=3
# install generated requirements.txt into a temp venv before pytest
TEST_USE_VENV=true
TEST_INSTALL_TIMEOUT=300
TEST_TIMEOUT=120
